# مفتاح Claude — يُحفظ على الخادم فقط ولا يصل إلى الواجهة أبدًا
ANTHROPIC_API_KEY=
# anthropic (افتراضي عند وجود المفتاح) | demo (وضع تجريبي معلن، بلا ذكاء اصطناعي ولا مصادر)
MANARA_AI=
# النموذج الأقوى (التخطيط والتركيب العلمي) والنموذج الأخف (المقابلة والمراجعة)
MANARA_MODEL_STRONG=claude-opus-5-5
MANARA_MODEL_FAST=claude-haiku-5-5
PORT=8787
DATA_DIR=./data
# بريد المشرفين (مفصول بفواصل) للوحة الإدارة
ADMIN_EMAILS=

# التنبيهات من الخادم (Web Push). إن تُركت فارغة تُولَّد المفاتيح وتُحفظ في DATA_DIR/vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# تنبيهات تطبيق أندرويد الأصلي عبر Firebase Cloud Messaging: مسار ملف حساب الخدمة أو محتواه JSON
FCM_SERVICE_ACCOUNT=
